{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "snippet": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Tech",
        "Life",
        "Travel"
      ]
    },
    "content": {
      "type": "richtext"
    }
  }
}
